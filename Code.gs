function apiSetOrderStatus_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var orderId = cleanText_(payload && payload.orderId, 100);
  var nextStatus = String(payload && payload.status || '').toUpperCase();
  var description = cleanText_(payload && payload.description, 200);
  if (!ORDER_STATUS_LABELS[nextStatus]) throw new Error('สถานะคำสั่งซื้อไม่ถูกต้อง');

  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  var order;
  try {
    order = findById_('Orders', 'orderId', orderId);
    if (!order) throw new Error('ไม่พบคำสั่งซื้อ');
    var previousStatus = String(order.status || 'NEW');
    if (previousStatus === nextStatus) {
      return { ok: true, message: 'คำสั่งซื้อนี้อยู่ในสถานะดังกล่าวแล้ว', order: publicOrder_(order) };
    }
    var allowed = ALLOWED_TRANSITIONS[previousStatus] || [];
    if (allowed.indexOf(nextStatus) === -1) {
      throw new Error('ไม่สามารถเปลี่ยนสถานะจาก ' + (ORDER_STATUS_LABELS[previousStatus] || previousStatus) + ' เป็น ' + ORDER_STATUS_LABELS[nextStatus] + ' ได้');
    }

    var now = new Date();
    updateObjectById_('Orders', 'orderId', orderId, { status: nextStatus, updatedAt: now });
    appendOrderEvent_(orderId, previousStatus, nextStatus, 'ADMIN', description || ORDER_STATUS_LABELS[nextStatus]);
    order.status = nextStatus;
    order.updatedAt = now;
  } finally {
    lock.releaseLock();
  }

  sendCustomerOrderStatusNotification_(order);
  return { ok: true, message: 'เปลี่ยนสถานะคำสั่งซื้อแล้ว', order: publicOrder_(order) };
}

