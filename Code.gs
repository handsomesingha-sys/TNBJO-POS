/** Run this function once from the Apps Script editor. */
function setupSystem() {
  var spreadsheet = getDatabaseSpreadsheet_();
  ensureAllSheets_();
  seedDefaultSettings_();

  var properties = PropertiesService.getScriptProperties();
  if (!properties.getProperty('ADMIN_PASSWORD_HASH')) {
    properties.setProperty('ADMIN_PASSWORD_HASH', sha256Hex_(APP.DEFAULT_ADMIN_PASSWORD));
  }
  if (!properties.getProperty('ADMIN_AUTH_VERSION')) {
    properties.setProperty('ADMIN_AUTH_VERSION', '1');
  }

  try {
    spreadsheet.setSpreadsheetTimeZone(APP.TIME_ZONE);
  } catch (timezoneError) {
    consoleLog_('Could not set spreadsheet timezone: ' + timezoneError);
  }

  var result = {
    ok: true,
    message: 'ตั้งค่าระบบเรียบร้อยแล้ว',
    spreadsheetName: spreadsheet.getName(),
    spreadsheetUrl: spreadsheet.getUrl(),
    spreadsheetId: spreadsheet.getId(),
    sheets: Object.keys(APP.SHEETS),
    initialAdminPassword: APP.DEFAULT_ADMIN_PASSWORD,
    note: 'กรุณาเปลี่ยนรหัสผ่านหลังบ้านก่อนเปิดใช้งานจริง'
  };
  Logger.log(JSON.stringify(result, null, 2));
  return result;
}

/** Alias for convenience. */
function initializeSystem() {
  return setupSystem();
}

