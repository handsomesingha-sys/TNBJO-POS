function setLineGroupId(groupId) {
  var value = String(groupId || '').trim();
  if (!value) throw new Error('กรุณาระบุ LINE Group ID');
  PropertiesService.getScriptProperties().setProperty('LINE_GROUP_ID', value);
  return 'บันทึก LINE Group ID แล้ว';
