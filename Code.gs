/* 3. DATABASE / GOOGLE SHEETS HELPERS                                        */
/* ========================================================================== */

function getDatabaseSpreadsheet_() {
  var properties = PropertiesService.getScriptProperties();
  var spreadsheetId = properties.getProperty('SPREADSHEET_ID');
  if (spreadsheetId) {
    try {
      return SpreadsheetApp.openById(spreadsheetId);
    } catch (error) {
      throw new Error('เปิด Google Sheet ไม่ได้ กรุณาตรวจสอบ SPREADSHEET_ID และสิทธิ์ของบัญชีที่ Deploy: ' + error.message);
    }
  }

  var active = SpreadsheetApp.getActiveSpreadsheet();
  if (active) {
    properties.setProperty('SPREADSHEET_ID', active.getId());
    return active;
  }

  var created = SpreadsheetApp.create('ฐานข้อมูลร้านก๋วยเตี๋ยวโบราณ by เจ๊อ้น');
  properties.setProperty('SPREADSHEET_ID', created.getId());
  return created;
}

function ensureAllSheets_() {
  var spreadsheet = getDatabaseSpreadsheet_();
  Object.keys(APP.SHEETS).forEach(function (sheetName) {
    ensureSheetHeaders_(spreadsheet, sheetName, APP.SHEETS[sheetName]);
  });
  var defaultSheet = spreadsheet.getSheetByName('Sheet1');
  if (defaultSheet && defaultSheet.getLastRow() === 0 && spreadsheet.getSheets().length > 1) {
    spreadsheet.deleteSheet(defaultSheet);
  }
  return spreadsheet;
}

function ensureSheetHeaders_(spreadsheet, sheetName, headers) {
  var sheet = spreadsheet.getSheetByName(sheetName);
  if (!sheet) sheet = spreadsheet.insertSheet(sheetName);

  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
    return sheet;
  }

  var lastColumn = Math.max(sheet.getLastColumn(), 1);
  var currentHeaders = sheet.getRange(1, 1, 1, lastColumn).getValues()[0].map(function (value) {
    return String(value || '').trim();
  });

  if (!currentHeaders.some(function (value) { return value; })) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
    return sheet;
  }

  var missing = headers.filter(function (header) {
    return currentHeaders.indexOf(header) === -1;
  });
  if (missing.length) {
    sheet.getRange(1, lastColumn + 1, 1, missing.length).setValues([missing]);
  }
  sheet.setFrozenRows(1);
  return sheet;
}

function seedDefaultSettings_() {
  Object.keys(APP.DEFAULT_SETTINGS).forEach(function (key) {
    if (getSetting_(key, null) === null) setSetting_(key, APP.DEFAULT_SETTINGS[key]);
  });
}

function sheet_(sheetName) {
  var spreadsheet = getDatabaseSpreadsheet_();
  var sheet = spreadsheet.getSheetByName(sheetName);
  if (!sheet) {
    if (!APP.SHEETS[sheetName]) throw new Error('ไม่พบโครงสร้างชีต: ' + sheetName);
    sheet = ensureSheetHeaders_(spreadsheet, sheetName, APP.SHEETS[sheetName]);
  }
  return sheet;
}

function headers_(sheet) {
  var count = sheet.getLastColumn();
  if (!count) return [];
  return sheet.getRange(1, 1, 1, count).getValues()[0].map(function (value) {
    return String(value || '').trim();
  });
}

function getRows_(sheetName) {
  var sheet = sheet_(sheetName);
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];

  var headers = headers_(sheet);
  var values = sheet.getRange(2, 1, lastRow - 1, headers.length).getValues();
  return values.map(function (row, index) {
    var object = { _rowNumber: index + 2 };
    headers.forEach(function (header, columnIndex) {
      if (header) object[header] = row[columnIndex];
    });
    return object;
  }).filter(function (object) {
    return headers.some(function (header) {
      return header && object[header] !== '' && object[header] !== null;
    });
  });
}

function appendObject_(sheetName, object) {
  var sheet = sheet_(sheetName);
  var headers = headers_(sheet);
  var row = headers.map(function (header) {
    return Object.prototype.hasOwnProperty.call(object, header) ? object[header] : '';
  });
  sheet.appendRow(row);
  return sheet.getLastRow();
}

function updateObjectById_(sheetName, idField, idValue, updates) {
  var sheet = sheet_(sheetName);
  var headers = headers_(sheet);
  var rows = getRows_(sheetName);
  var found = null;
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][idField]) === String(idValue)) {
      found = rows[i];
      break;
    }
  }
  if (!found) return false;

  var values = sheet.getRange(found._rowNumber, 1, 1, headers.length).getValues()[0];
  headers.forEach(function (header, index) {
    if (Object.prototype.hasOwnProperty.call(updates, header)) values[index] = updates[header];
  });
  sheet.getRange(found._rowNumber, 1, 1, headers.length).setValues([values]);
  return true;
}

function findById_(sheetName, idField, idValue) {
  var rows = getRows_(sheetName);
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][idField]) === String(idValue)) return rows[i];
  }
  return null;
}

function findByField_(sheetName, fieldName, fieldValue) {
  var rows = getRows_(sheetName);
  return rows.filter(function (row) {
    return String(row[fieldName]) === String(fieldValue);
  });
}

function getSetting_(key, fallback) {
  var rows = getRows_("Settings");
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i].key) === String(key)) {
      return safeJsonParse_(String(rows[i].value), rows[i].value);
    }
  }
  return fallback;
}

function setSetting_(key, value) {
  var sheet = sheet_('Settings');
  var rows = getRows_('Settings');
  var serialized = JSON.stringify(value);
  var now = new Date();
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i].key) === String(key)) {
      return updateObjectById_('Settings', 'key', key, {
        value: serialized,
        updatedAt: now
      });
    }
  }
  appendObject_('Settings', { key: key, value: serialized, updatedAt: now });
  return true;
}

function getSettingsObject_() {
  var result = {};
  Object.keys(APP.DEFAULT_SETTINGS).forEach(function (key) {
    result[key] = getSetting_(key, APP.DEFAULT_SETTINGS[key]);
  });
  return result;
}

