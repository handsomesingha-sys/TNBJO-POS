    uniqueIds[id] = true;
    appendObject_('MenuItemOptionGroups', {
      mappingId: newId_('MAP'),
      menuItemId: id,
      groupId: groupId,
      sortOrder: index,
      isActive: true,
      createdAt: now
    });
