/* 4. PUBLIC CUSTOMER API                                                     */
/* ========================================================================== */

function apiGetPublicBootstrap_() {
  ensureAllSheets_();
  seedDefaultSettings_();

  var categories = getRows_('Categories').filter(function (row) {
    return asBoolean_(row.isActive);
  }).sort(sortByOrder_).map(function (row) {
    return {
      categoryId: String(row.categoryId),
      name: String(row.name || ''),
      sortOrder: toNumber_(row.sortOrder, 0)
    };
  });

  var groups = getRows_('MenuOptionGroups');
  var options = getRows_('MenuOptions');
  var mappings = getRows_('MenuItemOptionGroups').filter(function (row) {
    return asBoolean_(row.isActive);
  });

  var menuItems = getRows_('MenuItems').filter(function (row) {
    return asBoolean_(row.isAvailable);
  }).sort(sortByOrder_).map(function (item) {
    var itemMappings = mappings.filter(function (mapping) {
      return String(mapping.menuItemId) === String(item.menuItemId);
    });
    var itemGroups = itemMappings.map(function (mapping) {
      var group = findInArray_(groups, 'groupId', mapping.groupId);
      if (!group || !asBoolean_(group.isActive)) return null;
      return {
        groupId: String(group.groupId),
        name: String(group.name || ''),
        isRequired: asBoolean_(group.isRequired),
        minSelect: toNumber_(group.minSelect, 0),
        maxSelect: toNumber_(group.maxSelect, 1),
        sortOrder: toNumber_(group.sortOrder, 0),
        options: options.filter(function (option) {
          return String(option.groupId) === String(group.groupId) && asBoolean_(option.isActive);
        }).sort(sortByOrder_).map(function (option) {
          return {
            optionId: String(option.optionId),
            name: String(option.name || ''),
            priceAdjustment: toNumber_(option.priceAdjustment, 0),
            sortOrder: toNumber_(option.sortOrder, 0)
          };
        })
      };
    }).filter(function (group) { return Boolean(group); }).sort(sortByOrder_);

    return {
      menuItemId: String(item.menuItemId),
      categoryId: String(item.categoryId || ''),
      name: String(item.name || ''),
      description: String(item.description || ''),
      price: toNumber_(item.price, 0),
      imageUrl: String(item.imageUrl || ''),
      isFeatured: asBoolean_(item.isFeatured),
      sortOrder: toNumber_(item.sortOrder, 0),
      optionGroups: itemGroups
    };
  });

  var settings = getSettingsObject_();
  var publicSettings = {
    restaurantName: settings.restaurantName,
    restaurantDescription: settings.restaurantDescription,
    brandLogoUrl: settings.brandLogoUrl,
    homeBannerImageUrl: settings.homeBannerImageUrl,
    homeBannerEyebrow: settings.homeBannerEyebrow,
    homeBannerTitle: settings.homeBannerTitle,
    homeBannerSubtitle: settings.homeBannerSubtitle,
    homeBannerHeight: settings.homeBannerHeight,
    allowCashPayment: settings.allowCashPayment,
    allowTransferPayment: settings.allowTransferPayment,
    allowDineIn: settings.allowDineIn,
    allowTakeaway: settings.allowTakeaway,
    allowDelivery: settings.allowDelivery,
    orderAcceptMessage: settings.orderAcceptMessage,
    pointsCurrencyStep: settings.pointsCurrencyStep,
    pointsPerStep: settings.pointsPerStep
  };

  return {
    ok: true,
    version: APP.VERSION,
    serverTime: nowIso_(),
    store: getStoreStatus_(),
    settings: publicSettings,
    categories: categories,
    menuItems: menuItems
  };
}

function apiCreateOrder_(payload) {
  payload = payload || {};
  var lineUser = verifyLiffUser_(payload.idToken);
  var idempotencyKey = cleanText_(payload.idempotencyKey, 100);
  if (!idempotencyKey) throw new Error('ไม่พบรหัสป้องกันการส่งคำสั่งซื้อซ้ำ กรุณาลองใหม่');

  var existing = getRows_('Orders').filter(function (row) {
    return String(row.lineUserId) === lineUser.userId && String(row.idempotencyKey) === idempotencyKey;
  })[0];
  if (existing) {
    return {
      ok: true,
      duplicate: true,
      order: publicOrder_(existing),
      message: 'คำสั่งซื้อนี้ถูกบันทึกแล้ว'
    };
  }

  var orderType = String(payload.orderType || 'TAKEAWAY').toUpperCase();
  if (['DINE_IN', 'TAKEAWAY', 'DELIVERY'].indexOf(orderType) === -1) {
    throw new Error('ประเภทการรับอาหารไม่ถูกต้อง');
  }

  var settings = getSettingsObject_();
  if (orderType === 'DINE_IN' && !asBoolean_(settings.allowDineIn)) throw new Error('ขณะนี้ร้านยังไม่เปิดรับประทานที่ร้าน');
  if (orderType === 'TAKEAWAY' && !asBoolean_(settings.allowTakeaway)) throw new Error('ขณะนี้ร้านยังไม่เปิดรับกลับบ้าน');
  if (orderType === 'DELIVERY' && !asBoolean_(settings.allowDelivery)) throw new Error('ขณะนี้ร้านยังไม่เปิดบริการจัดส่ง');

  var paymentMethod = String(payload.paymentMethod || 'CASH').toUpperCase();
  if (['CASH', 'TRANSFER'].indexOf(paymentMethod) === -1) throw new Error('วิธีชำระเงินไม่ถูกต้อง');
  if (paymentMethod === 'CASH' && !asBoolean_(settings.allowCashPayment)) throw new Error('ร้านยังไม่เปิดรับชำระเงินสด');
  if (paymentMethod === 'TRANSFER' && !asBoolean_(settings.allowTransferPayment)) throw new Error('ร้านยังไม่เปิดรับชำระเงินโอน');

  var itemsInput = Array.isArray(payload.items) ? payload.items : [];
  if (!itemsInput.length) throw new Error('กรุณาเลือกอาหารอย่างน้อย 1 รายการ');
  if (itemsInput.length > APP.MAX_ORDER_ITEMS) throw new Error('จำนวนรายการอาหารมากเกินไป');

  var normalized = normalizeOrderItems_(itemsInput);
  var subtotal = roundMoney_(normalized.reduce(function (sum, item) {
    return sum + item.totalPrice;
  }, 0));
  var discount = 0;
  // Delivery fees are calculated server-side; never trust a price sent by the browser.
  var deliveryFee = orderType === 'DELIVERY' ? Math.max(0, toNumber_(settings.deliveryFee, 0)) : 0;
  var total = roundMoney_(subtotal - discount + deliveryFee);
  if (total <= 0) throw new Error('ยอดคำสั่งซื้อไม่ถูกต้อง');

  var tableNo = cleanText_(payload.tableNo, 30);
  var deliveryAddress = cleanText_(payload.deliveryAddress, 500);
  if (orderType === 'DINE_IN' && !tableNo) throw new Error('กรุณาระบุเลขโต๊ะ');
  if (orderType === 'DELIVERY' && !deliveryAddress) throw new Error('กรุณาระบุที่อยู่จัดส่ง');

  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  var order;
  try {
    var duplicateInsideLock = getRows_('Orders').filter(function (row) {
      return String(row.lineUserId) === lineUser.userId && String(row.idempotencyKey) === idempotencyKey;
    })[0];
    if (duplicateInsideLock) {
      return {
        ok: true,
        duplicate: true,
        order: publicOrder_(duplicateInsideLock),
        message: 'คำสั่งซื้อนี้ถูกบันทึกแล้ว'
      };
    }

    var storeStatus = getStoreStatus_();
    if (!storeStatus.isOpen) {
      throw new Error(storeStatus.closeReason || 'ขออภัย ขณะนี้ร้านปิดรับออเดอร์ชั่วคราว');
    }

    // Recheck the daily limit while holding the lock to avoid concurrent overbooking.
    var currentCount = countTodayOrders_();
    if (asBoolean_(settings.maxOrdersEnabled) && currentCount >= toNumber_(settings.maxOrdersPerDay, 0)) {
      closeStoreByOrderLimit_();
      throw new Error(getSetting_('closeReason', 'ขออภัย วันนี้ร้านรับออเดอร์ครบจำนวนแล้ว'));
    }

    var now = new Date();
    var orderId = newId_('ORD');
    order = {
      orderId: orderId,
      orderNo: nextOrderNumber_(),
      idempotencyKey: idempotencyKey,
      lineUserId: lineUser.userId,
      customerName: cleanText_(payload.customerName, 100) || lineUser.displayName || 'ลูกค้า LINE',
      customerPicture: lineUser.pictureUrl || '',
      orderType: orderType,
      tableNo: tableNo,
      deliveryAddress: deliveryAddress,
      phone: cleanText_(payload.phone, 30),
      itemsCount: normalized.reduce(function (sum, item) { return sum + item.quantity; }, 0),
      subtotal: subtotal,
      discount: discount,
      deliveryFee: deliveryFee,
      total: total,
      paymentMethod: paymentMethod,
      paymentStatus: 'UNPAID',
      note: cleanText_(payload.note, 500),
      status: ORDER_STATUS.NEW,
      createdAt: now,
      updatedAt: now
    };

    appendObject_('Orders', order);
    normalized.forEach(function (item) {
      appendObject_('OrderItems', {
        orderItemId: newId_('OIT'),
        orderId: orderId,
        menuItemId: item.menuItemId,
        menuItemName: item.menuItemName,
        basePrice: item.basePrice,
        quantity: item.quantity,
        unitPrice: item.unitPrice,
        totalPrice: item.totalPrice,
        optionsJson: JSON.stringify(item.options),
        note: item.note,
        createdAt: now
      });
    });

    appendOrderEvent_(orderId, '', ORDER_STATUS.NEW, 'CUSTOMER', 'สร้างคำสั่งซื้อ');
    upsertCustomerAfterOrder_(lineUser, total, now);
    maybeAutoCloseForDailyLimit_();
  } finally {
    lock.releaseLock();
  }

  sendNewOrderNotification_(order, normalized);
  sendCustomerOrderCreatedNotification_(order);

  return {
    ok: true,
    message: 'ส่งคำสั่งซื้อเรียบร้อยแล้ว',
    order: publicOrder_(order),
    store: getStoreStatus_()
  };
}

