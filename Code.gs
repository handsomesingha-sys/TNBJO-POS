    qr.status = 'EXPIRED';
  }
  return {
    ok: true,
    status: String(qr.status),
    amount: toNumber_(qr.amount, 0),
    points: toNumber_(qr.points, 0),
    lineUserId: String(qr.lineUserId || ''),
    expiresAt: dateToIso_(qr.expiresAt)
  };
}

function apiRedeemCustomerLoyaltyQr_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var token = extractQrToken_(payload && (payload.qrValue || payload.token));
  var amount = roundMoney_(toNumber_(payload && payload.amount, 0));
  if (!token) throw new Error('QR Code ลูกค้าไม่ถูกต้อง');
  if (amount <= 0) throw new Error('กรุณากรอกยอดซื้อของลูกค้า');

  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    var qr = findByField_('LoyaltyQrs', 'token', token)[0];
    if (!qr || String(qr.type) !== 'CUSTOMER_SCAN') throw new Error('ไม่พบ QR Code ของลูกค้า');
    validateActiveQr_(qr);
    var lineUserId = String(qr.lineUserId || '');
    if (!lineUserId) throw new Error('QR Code นี้ไม่มีเจ้าของ');
    var points = calculatePoints_(amount);
    if (points <= 0) throw new Error('ยอดซื้อนี้ยังไม่เข้าเงื่อนไขสะสมแต้ม');

    updateObjectById_('LoyaltyQrs', 'qrId', qr.qrId, {
      amount: amount,
      points: points,
      status: 'REDEEMED',
      usedAt: new Date()
    });
    addPointsLedger_(lineUserId, 'EARN', points, amount, qr.qrId,
      'สะสมแต้มจากการซื้ออาหาร', 'ADMIN');

    return {
      ok: true,
      message: 'สะสมแต้มสำเร็จ',
      lineUserId: lineUserId,
      amount: amount,
      pointsEarned: points,
      pointsBalance: getCustomerPointsBalance_(lineUserId)
    };
  } finally {
    lock.releaseLock();
  }
}

function apiAdjustCustomerPoints_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var lineUserId = cleanText_(payload && payload.lineUserId, 100);
  var points = Math.floor(toNumber_(payload && payload.points, 0));
  var reason = cleanText_(payload && payload.reason, 200);
  if (!lineUserId) throw new Error('กรุณาระบุ LINE User ID');
  if (!points) throw new Error('จำนวนแต้มต้องไม่เป็น 0');
  if (!reason) throw new Error('กรุณาระบุเหตุผลในการปรับแต้ม');

  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    var balance = getCustomerPointsBalance_(lineUserId);
    if (balance + points < 0) throw new Error('แต้มคงเหลือไม่เพียงพอสำหรับการปรับลด');
    addPointsLedger_(lineUserId, points > 0 ? 'ADJUST_PLUS' : 'ADJUST_MINUS', points, 0,
      newId_('ADJ'), reason, 'ADMIN');
  } finally {
    lock.releaseLock();
  }
  logAudit_('ADMIN', 'ADJUST_CUSTOMER_POINTS', 'CUSTOMER', lineUserId, { points: points, reason: reason });
  return { ok: true, pointsBalance: getCustomerPointsBalance_(lineUserId) };
}

function apiGetAdminCustomers_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var query = cleanText_(payload && payload.query, 100).toLowerCase();
  var rows = getRows_('Customers').sort(function (a, b) {
    return dateMillis_(b.lastOrderAt) - dateMillis_(a.lastOrderAt);
  });
  if (query) {
    rows = rows.filter(function (row) {
      return String(row.displayName || '').toLowerCase().indexOf(query) !== -1 ||
        String(row.lineUserId || '').toLowerCase().indexOf(query) !== -1;
    });
  }
  return {
    ok: true,
    customers: rows.slice(0, 200).map(function (row) {
      return {
        lineUserId: String(row.lineUserId),
        displayName: String(row.displayName || ''),
        pictureUrl: String(row.pictureUrl || ''),
        totalOrders: toNumber_(row.totalOrders, 0),
        totalSpent: toNumber_(row.totalSpent, 0),
        pointsBalance: toNumber_(row.pointsBalance, 0),
        lastOrderAt: dateToIso_(row.lastOrderAt)
      };
    })
  };
}

function calculatePoints_(amount) {
  var settings = getSettingsObject_();
  var currencyStep = Math.max(0.01, toNumber_(settings.pointsCurrencyStep, 10));
  var pointsPerStep = Math.max(1, Math.floor(toNumber_(settings.pointsPerStep, 1)));
  return Math.floor(toNumber_(amount, 0) / currencyStep) * pointsPerStep;
}

function validateActiveQr_(qr) {
  if (String(qr.status) !== 'ACTIVE') throw new Error('QR Code นี้ถูกใช้งานหรือยกเลิกไปแล้ว');
  if (dateMillis_(qr.expiresAt) <= Date.now()) {
    updateObjectById_('LoyaltyQrs', 'qrId', qr.qrId, { status: 'EXPIRED' });
    throw new Error('QR Code หมดอายุแล้ว กรุณาสร้าง QR Code ใหม่');
  }
}

function extractQrToken_(value) {
  var text = String(value || '').trim();
  if (!text) return '';
  var parts = text.split('|');
  if (parts.length === 3 && parts[0] === 'JAEON') return parts[2];
  return text;
}

function addPointsLedger_(lineUserId, type, points, amount, referenceId, description, createdBy) {
  var numericPoints = Math.floor(toNumber_(points, 0));
  if (!numericPoints) throw new Error('จำนวนแต้มไม่ถูกต้อง');
  var currentBalance = getCustomerPointsBalance_(lineUserId);
  if (currentBalance + numericPoints < 0) throw new Error('แต้มคงเหลือไม่เพียงพอ');

  appendObject_('PointsLedger', {
    ledgerId: newId_('LED'),
    lineUserId: lineUserId,
    type: type,
    points: numericPoints,
    amount: roundMoney_(amount),
    referenceId: referenceId,
    description: description,
    createdAt: new Date(),
    createdBy: createdBy
  });

  var customer = findById_('Customers', 'lineUserId', lineUserId);
  if (customer) {
    updateObjectById_('Customers', 'lineUserId', lineUserId, {
      pointsBalance: currentBalance + numericPoints,
      updatedAt: new Date()
    });
  } else {
    appendObject_('Customers', {
      lineUserId: lineUserId,
      displayName: '',
      pictureUrl: '',
      totalOrders: 0,
      totalSpent: 0,
      pointsBalance: numericPoints,
      lastOrderAt: '',
      createdAt: new Date(),
      updatedAt: new Date()
    });
  }
}

function getCustomerPointsBalance_(lineUserId) {
  var customer = findById_('Customers', 'lineUserId', lineUserId);
  if (customer) return toNumber_(customer.pointsBalance, 0);
  return getRows_('PointsLedger').filter(function (row) {
    return String(row.lineUserId) === String(lineUserId);
  }).reduce(function (sum, row) {
    return sum + toNumber_(row.points, 0);
  }, 0);
}

