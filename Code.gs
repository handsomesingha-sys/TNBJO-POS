  var minSelect = Math.max(0, Math.floor(toNumber_(payload && payload.minSelect, 0)));
  var maxSelect = Math.max(1, Math.floor(toNumber_(payload && payload.maxSelect, 1)));
  if (maxSelect < minSelect) throw new Error('จำนวนที่เลือกสูงสุดต้องไม่น้อยกว่าจำนวนขั้นต่ำ');
  var isRequired = asBoolean_(payload && payload.isRequired);
  if (isRequired && minSelect < 1) minSelect = 1;

  var current = findById_('MenuOptionGroups', 'groupId', groupId);
  var now = new Date();
  var record = {
    groupId: groupId,
    name: name,
    isRequired: isRequired,
    minSelect: minSelect,
    maxSelect: maxSelect,
    sortOrder: toNumber_(payload && payload.sortOrder, 0),
    isActive: payload.isActive === undefined ? true : asBoolean_(payload.isActive),
    createdAt: current ? current.createdAt : now,
    updatedAt: now
  };
  if (current) updateObjectById_('MenuOptionGroups', 'groupId', groupId, record);
  else appendObject_('MenuOptionGroups', record);

  // Replace menu-to-group mappings without deleting the historical rows.
  var mappings = getRows_('MenuItemOptionGroups').filter(function (row) {
    return String(row.groupId) === groupId && asBoolean_(row.isActive);
  });
  mappings.forEach(function (mapping) {
    updateObjectById_('MenuItemOptionGroups', 'mappingId', mapping.mappingId, { isActive: false });
  });
  var itemIds = Array.isArray(payload.menuItemIds) ? payload.menuItemIds : [];
  var uniqueIds = {};
