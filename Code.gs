function apiUploadImage_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var apiKey = getProperty_('IMGBB_API_KEY');
  if (!apiKey) throw new Error('ยังไม่ได้ตั้งค่า IMGBB_API_KEY ใน Script Properties');

  var base64 = String(payload && payload.imageBase64 || '').replace(/^data:image\/[a-zA-Z0-9.+-]+;base64,/, '').trim();
  if (!base64) throw new Error('ไม่พบข้อมูลรูปภาพ');
  if (base64.length > APP.MAX_IMAGE_BASE64_CHARS) throw new Error('รูปภาพมีขนาดใหญ่เกินไป กรุณาย่อรูปก่อนอัปโหลด');
  if (!/^[A-Za-z0-9+/=]+$/.test(base64)) throw new Error('ข้อมูลรูปภาพไม่ถูกต้อง');

  var fileName = cleanText_(payload && payload.fileName, 100) || ('jaeon-' + Date.now() + '.jpg');
  var endpoint = 'https://api.imgbb.com/1/upload?key=' + encodeURIComponent(apiKey);
  var response = UrlFetchApp.fetch(endpoint, {
    method: 'post',
    payload: {
      image: base64,
      name: fileName
    },
    muteHttpExceptions: true
  });
  var status = response.getResponseCode();
  var result = safeJsonParse_(response.getContentText(), {});
  if (status < 200 || status >= 300 || !result.success || !result.data) {
    throw new Error('อัปโหลดรูปภาพไม่สำเร็จ กรุณาตรวจสอบ ImgBB API Key หรือไฟล์รูปภาพ');
  }
  return {
    ok: true,
    imageUrl: String(result.data.url || result.data.display_url || ''),
    fileName: fileName
  };
}

