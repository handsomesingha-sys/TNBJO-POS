function apiAdminLogin_(payload) {
  ensureAllSheets_();
  var password = String(payload && payload.password || '');
  if (!password) throw new Error('กรุณากรอกรหัสเข้าใช้งาน');

  var properties = PropertiesService.getScriptProperties();
  var expectedHash = properties.getProperty('ADMIN_PASSWORD_HASH');
  if (!expectedHash) {
    expectedHash = sha256Hex_(APP.DEFAULT_ADMIN_PASSWORD);
    properties.setProperty('ADMIN_PASSWORD_HASH', expectedHash);
  }

  if (!constantTimeEquals_(sha256Hex_(password), expectedHash)) {
    Utilities.sleep(500);
    throw new Error('รหัสเข้าใช้งานไม่ถูกต้อง');
  }

  var token = newToken_();
  var sessionData = {
    createdAt: Date.now(),
    expiresAt: Date.now() + APP.ADMIN_SESSION_TTL_SECONDS * 1000,
    authVersion: getProperty_('ADMIN_AUTH_VERSION') || '1'
  };
  CacheService.getScriptCache().put(
    'ADMIN_SESSION_' + sha256Hex_(token),
    JSON.stringify(sessionData),
    APP.ADMIN_SESSION_TTL_SECONDS
  );

  logAudit_('ADMIN', 'LOGIN', 'SESSION', '', {});
  return {
    ok: true,
    sessionToken: token,
    expiresInSeconds: APP.ADMIN_SESSION_TTL_SECONDS
  };
}

function apiAdminLogout_(payload) {
  var token = String(payload && payload.sessionToken || '');
  if (token) CacheService.getScriptCache().remove('ADMIN_SESSION_' + sha256Hex_(token));
  return { ok: true, message: 'ออกจากระบบแล้ว' };
}

function apiChangeAdminPassword_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var newPassword = String(payload && payload.newPassword || '');
  if (newPassword.length < 8) throw new Error('รหัสผ่านใหม่ต้องมีอย่างน้อย 8 ตัวอักษร');
  PropertiesService.getScriptProperties().setProperty('ADMIN_PASSWORD_HASH', sha256Hex_(newPassword));
  incrementAdminAuthVersion_();
  logAudit_('ADMIN', 'CHANGE_PASSWORD', 'SETTINGS', 'ADMIN_PASSWORD', {});
  return { ok: true, message: 'เปลี่ยนรหัสผ่านเรียบร้อยแล้ว กรุณาเข้าสู่ระบบใหม่' };
}

function incrementAdminAuthVersion_() {
  var properties = PropertiesService.getScriptProperties();
  var current = Number(properties.getProperty('ADMIN_AUTH_VERSION') || 1);
  properties.setProperty('ADMIN_AUTH_VERSION', String(current + 1));
}

function requireAdmin_(sessionToken) {
  var token = String(sessionToken || '');
  if (!token) throw new Error('กรุณาเข้าสู่ระบบหลังบ้าน');
  var key = 'ADMIN_SESSION_' + sha256Hex_(token);
  var cached = CacheService.getScriptCache().get(key);
  if (!cached) throw new Error('Session หมดอายุ กรุณาเข้าสู่ระบบใหม่');
  var session = safeJsonParse_(cached, null);
  if (!session || Number(session.expiresAt) <= Date.now() ||
      String(session.authVersion || '1') !== String(getProperty_('ADMIN_AUTH_VERSION') || '1')) {
    CacheService.getScriptCache().remove(key);
    throw new Error('Session หมดอายุหรือถูกยกเลิก กรุณาเข้าสู่ระบบใหม่');
  }
  return true;
}

