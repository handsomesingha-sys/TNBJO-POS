function sendLinePush_(to, messages) {
  var accessToken = getProperty_('LINE_CHANNEL_ACCESS_TOKEN');
  if (!accessToken || !to) return false;
  try {
    var response = UrlFetchApp.fetch('https://api.line.me/v2/bot/message/push', {
      method: 'post',
      contentType: 'application/json',
      headers: { Authorization: 'Bearer ' + accessToken },
      payload: JSON.stringify({ to: to, messages: messages }),
      muteHttpExceptions: true
    });
    var status = response.getResponseCode();
    if (status < 200 || status >= 300) {
      logAudit_('SYSTEM', 'LINE_PUSH_FAILED', 'LINE', to, {
        status: status,
        response: response.getContentText().substring(0, 500)
      });
      return false;
    }
    return true;
  } catch (error) {
    logAudit_('SYSTEM', 'LINE_PUSH_EXCEPTION', 'LINE', to, {
      message: String(error && error.message ? error.message : error).substring(0, 300)
    });
    return false;
  }
}

