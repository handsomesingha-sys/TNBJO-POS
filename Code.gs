function apiGetAdminBootstrap_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  ensureAllSheets_();
  seedDefaultSettings_();
  var todayOrders = getRows_('Orders').filter(function (row) {
    return isToday_(row.createdAt);
  });
  var nonCancelledOrders = todayOrders.filter(function (row) {
    return String(row.status) !== ORDER_STATUS.CANCELLED;
  });
  var completedSales = nonCancelledOrders.reduce(function (sum, row) {
    return sum + toNumber_(row.total, 0);
  }, 0);

  var orderRows = todayOrders.slice().sort(function (a, b) {
    return dateMillis_(b.createdAt) - dateMillis_(a.createdAt);
  }).slice(0, 30);

  return {
    ok: true,
    version: APP.VERSION,
    store: getStoreStatus_(),
    settings: getSettingsObject_(),
    summary: {
      salesToday: roundMoney_(completedSales),
      ordersToday: todayOrders.filter(function (row) { return String(row.status) !== ORDER_STATUS.CANCELLED; }).length,
      pendingOrders: todayOrders.filter(function (row) {
        return [ORDER_STATUS.NEW, ORDER_STATUS.ACCEPTED, ORDER_STATUS.PREPARING, ORDER_STATUS.READY].indexOf(String(row.status)) !== -1;
      }).length,
      averageOrderValue: nonCancelledOrders.length ? roundMoney_(completedSales / nonCancelledOrders.length) : 0
    },
    categories: getRows_('Categories').sort(sortByOrder_),
    menuItems: getRows_('MenuItems').sort(sortByOrder_),
    optionGroups: getRows_('MenuOptionGroups').sort(sortByOrder_),
    options: getRows_('MenuOptions').sort(sortByOrder_),
    menuItemOptionGroups: getRows_('MenuItemOptionGroups'),
    recentOrders: orderRows.map(function (row) { return publicOrder_(row); })
  };
}

function apiGetAdminOrders_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var status = String(payload && payload.status || '').toUpperCase();
  var limit = Math.min(200, Math.max(1, toNumber_(payload && payload.limit, 100)));
  var rows = getRows_('Orders');
  if (status && status !== 'ALL') {
