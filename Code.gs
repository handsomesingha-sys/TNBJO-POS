function normalizeOrderItems_(itemsInput) {
  var allItems = getRows_('MenuItems');
  var groups = getRows_('MenuOptionGroups');
  var options = getRows_('MenuOptions');
  var mappings = getRows_('MenuItemOptionGroups').filter(function (row) { return asBoolean_(row.isActive); });
  var normalized = [];

  itemsInput.forEach(function (input) {
    var menuItemId = cleanText_(input && input.menuItemId, 100);
    var item = findInArray_(allItems, 'menuItemId', menuItemId);
    if (!item || !asBoolean_(item.isAvailable)) throw new Error('มีเมนูที่ปิดขายหรือไม่พบเมนู กรุณาโหลดรายการอาหารใหม่');

    var quantity = Math.floor(toNumber_(input.quantity, 0));
    if (quantity < 1 || quantity > APP.MAX_ITEM_QUANTITY) throw new Error('จำนวนอาหารของ ' + item.name + ' ไม่ถูกต้อง');

    var mappedGroupIds = mappings.filter(function (mapping) {
      return String(mapping.menuItemId) === menuItemId;
    }).map(function (mapping) { return String(mapping.groupId); });

    var selections = Array.isArray(input.selections) ? input.selections : [];
    var selectedGroups = {};
    selections.forEach(function (selection) {
      var groupId = String(selection.groupId || '');
      if (mappedGroupIds.indexOf(groupId) === -1) throw new Error('ตัวเลือกของเมนู ' + item.name + ' ไม่ถูกต้อง');
      if (selectedGroups[groupId]) throw new Error('พบกลุ่มตัวเลือกซ้ำกัน');
      selectedGroups[groupId] = Array.isArray(selection.optionIds) ? selection.optionIds.map(String) : [];
    });

    var selectedOptions = [];
    var addOnTotal = 0;
    mappedGroupIds.forEach(function (groupId) {
      var group = findInArray_(groups, 'groupId', groupId);
      if (!group || !asBoolean_(group.isActive)) return;
      var selectedIds = selectedGroups[groupId] || [];
      var minSelect = Math.max(asBoolean_(group.isRequired) ? 1 : 0, toNumber_(group.minSelect, 0));
      var maxSelect = Math.max(1, toNumber_(group.maxSelect, 1));
      if (selectedIds.length < minSelect || selectedIds.length > maxSelect) {
        throw new Error('กรุณาเลือก ' + group.name + ' ให้ครบตามจำนวนที่กำหนด');
      }
      var unique = {};
      selectedIds.forEach(function (optionId) {
        if (unique[optionId]) throw new Error('มีตัวเลือกซ้ำกัน');
        unique[optionId] = true;
        var option = findInArray_(options, 'optionId', optionId);
        if (!option || String(option.groupId) !== groupId || !asBoolean_(option.isActive)) {
          throw new Error('พบตัวเลือกที่ไม่พร้อมใช้งาน');
        }
        var adjustment = toNumber_(option.priceAdjustment, 0);
        addOnTotal += adjustment;
        selectedOptions.push({
          groupId: groupId,
          groupName: String(group.name),
          optionId: optionId,
          optionName: String(option.name),
          priceAdjustment: adjustment
        });
      });
    });

    // Reject selections for group IDs not mapped to this item.
    Object.keys(selectedGroups).forEach(function (groupId) {
      if (mappedGroupIds.indexOf(groupId) === -1) throw new Error('พบกลุ่มตัวเลือกที่ไม่ตรงกับเมนู');
    });

    var basePrice = toNumber_(item.price, 0);
    var unitPrice = roundMoney_(basePrice + addOnTotal);
    normalized.push({
      menuItemId: menuItemId,
      menuItemName: String(item.name),
      basePrice: basePrice,
      quantity: quantity,
      unitPrice: unitPrice,
      totalPrice: roundMoney_(unitPrice * quantity),
      options: selectedOptions,
      note: cleanText_(input.note, 200)
    });
  });
  return normalized;
}

