function verifyLiffUser_(idToken) {
  var token = String(idToken || '').trim();
  if (!token) throw new Error('ไม่พบ LINE ID Token กรุณาเปิดผ่าน LINE และอนุญาตการใช้งาน');
  var channelId = getProperty_('LIFF_CHANNEL_ID');
  if (!channelId) throw new Error('ระบบยังไม่ได้ตั้งค่า LIFF_CHANNEL_ID ใน Script Properties');
  if (!/^\d+$/.test(channelId)) throw new Error('ค่า LIFF_CHANNEL_ID ต้องเป็น Channel ID แบบตัวเลขของ LINE Login Channel ไม่ใช่ LIFF ID ที่มีเครื่องหมายขีด');

  var response = UrlFetchApp.fetch('https://api.line.me/oauth2/v2.1/verify', {
    method: 'post',
    payload: {
      id_token: token,
      client_id: channelId
    },
    muteHttpExceptions: true
  });
  var status = response.getResponseCode();
  var responseText = response.getContentText();
  var result = safeJsonParse_(responseText, {});
  if (status !== 200 || !result.sub) {
    var lineDetail = cleanText_(result.error_description || result.error || '', 180);
    var hint = 'ตรวจสอบค่า LIFF_CHANNEL_ID ใน Script Properties ให้เป็น Channel ID ของ LINE Login Channel เดียวกับ LIFF (ไม่ใช่ LIFF ID) และตรวจว่า LIFF เปิด Scope openid แล้ว';
    if (/invalid|audience|client_id|token/i.test(lineDetail)) {
      throw new Error('LINE ไม่ยอมรับ ID Token (' + (lineDetail || 'invalid token') + ') · ' + hint);
    }
    throw new Error('ตรวจสอบ LINE ID Token ไม่สำเร็จ (HTTP ' + status + ') · ' + hint);
  }

  return {
    userId: String(result.sub),
    displayName: cleanText_(result.name, 100),
    pictureUrl: safeHttpUrl_(result.picture)
  };
}

function ensureCustomer_(lineUser) {
  var existing = findById_('Customers', 'lineUserId', lineUser.userId);
  var now = new Date();
  if (existing) {
    updateObjectById_('Customers', 'lineUserId', lineUser.userId, {
      displayName: lineUser.displayName || existing.displayName,
      pictureUrl: lineUser.pictureUrl || existing.pictureUrl,
      updatedAt: now
    });
  } else {
    appendObject_('Customers', {
      lineUserId: lineUser.userId,
      displayName: lineUser.displayName,
      pictureUrl: lineUser.pictureUrl,
      totalOrders: 0,
      totalSpent: 0,
      pointsBalance: 0,
      lastOrderAt: '',
      createdAt: now,
      updatedAt: now
    });
  }
}

function upsertCustomerAfterOrder_(lineUser, total, now) {
  ensureCustomer_(lineUser);
  var customer = findById_('Customers', 'lineUserId', lineUser.userId);
  updateObjectById_('Customers', 'lineUserId', lineUser.userId, {
    totalOrders: toNumber_(customer.totalOrders, 0) + 1,
    totalSpent: roundMoney_(toNumber_(customer.totalSpent, 0) + total),
    lastOrderAt: now,
    updatedAt: now
  });
}

