/** Change the backend login password from the Apps Script editor. */
function setAdminPassword(newPassword) {
  var password = String(newPassword || '');
  if (password.length < 8) throw new Error('รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร');
  var properties = PropertiesService.getScriptProperties();
  properties.setProperty('ADMIN_PASSWORD_HASH', sha256Hex_(password));
  incrementAdminAuthVersion_();
  return 'เปลี่ยนรหัสผ่านหลังบ้านเรียบร้อยแล้ว';
}

