    setSetting_('homeBannerHeight', bannerHeight);
  }

  var booleanFields = [
    'allowCashPayment', 'allowTransferPayment', 'allowDineIn',
    'allowTakeaway', 'allowDelivery'
  ];
  booleanFields.forEach(function (key) {
    if (Object.prototype.hasOwnProperty.call(payload, key)) setSetting_(key, asBoolean_(payload[key]));
  });

  if (Object.prototype.hasOwnProperty.call(payload, 'deliveryFee')) {
    var deliveryFee = roundMoney_(toNumber_(payload.deliveryFee, -1));
    if (deliveryFee < 0) throw new Error('ค่าจัดส่งต้องไม่น้อยกว่า 0 บาท');
