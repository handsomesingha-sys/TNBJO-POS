/* ========================================================================== */
/* 1. WEB APP ENTRY POINTS                                                    */
/* ========================================================================== */

function doGet(e) {
  var params = (e && e.parameter) ? e.parameter : {};
  var action = String(params.action || 'ping');

  if (action === 'ping') {
    return outputJson_({
      ok: true,
      service: 'JaeOn Noodle Shop API',
      version: APP.VERSION,
      time: nowIso_()
    });
  }

  if (action === 'getPublicBootstrap') {
    var bootstrap = apiGetPublicBootstrap_();
    return outputResponse_(bootstrap, params.callback);
  }

  if (action === 'getRequestResult') {
    var requestId = String(params.requestId || '');
    if (!/^[A-Za-z0-9_-]{20,100}$/.test(requestId)) {
      return outputResponse_({ ok: false, message: 'รหัสคำขอไม่ถูกต้อง' }, params.callback);
    }
    var cached = CacheService.getScriptCache().get('API_RESULT_' + requestId);
    if (!cached) {
      return outputResponse_({ ok: true, pending: true }, params.callback);
    }
    return outputResponse_(safeJsonParse_(cached, {
      ok: false,
      message: 'ไม่สามารถอ่านผลการทำรายการได้'
    }), params.callback);
  }

  // All other operations must be sent using POST.
  return outputResponse_({
    ok: false,
    code: 'POST_REQUIRED',
    message: 'กรุณาเรียก API นี้ด้วย POST'
  }, params.callback);
}

function doPost(e) {
  try {
    var raw = (e && e.postData && e.postData.contents) ? e.postData.contents : '';
    if (!raw) {
      return outputJson_({ ok: false, message: 'ไม่พบข้อมูลคำขอ' });
    }

    var request = JSON.parse(raw);
    var requestId = String(request.requestId || '');
    var action = String(request.action || '');
    var payload = request.payload || {};

    if (!/^[A-Za-z0-9_-]{20,100}$/.test(requestId)) {
      return outputJson_({ ok: false, message: 'requestId ต้องเป็นรหัสสุ่มอย่างน้อย 20 ตัวอักษร' });
    }
    if (!/^[A-Za-z][A-Za-z0-9_]{1,60}$/.test(action)) {
      return outputJson_({ ok: false, message: 'ชื่อ action ไม่ถูกต้อง' });
    }

    var cache = CacheService.getScriptCache();
    var previous = cache.get('API_RESULT_' + requestId);
    if (previous) {
      return outputJson_({ ok: true, duplicateRequest: true });
    }

    var result;
    try {
      result = dispatchApiAction_(action, payload);
    } catch (actionError) {
      result = {
        ok: false,
        code: 'API_ERROR',
        message: publicErrorMessage_(actionError),
        requestId: requestId
      };
      logAudit_('SYSTEM', 'API_ERROR', 'API', action, {
        message: String(actionError && actionError.message ? actionError.message : actionError)
      });
    }

    result = result || { ok: false, message: 'ไม่สามารถดำเนินการได้' };
    result.requestId = requestId;

    try {
      cache.put('API_RESULT_' + requestId, JSON.stringify(result), APP.REQUEST_RESULT_TTL_SECONDS);
    } catch (cacheError) {
      // The result endpoint is best-effort. The underlying transaction has already run.
      consoleLog_('Unable to cache request result: ' + cacheError);
    }

    return outputJson_({ ok: true, accepted: true, requestId: requestId });
  } catch (error) {
    consoleLog_('doPost error: ' + error);
    return outputJson_({ ok: false, message: publicErrorMessage_(error) });
  }
}

function dispatchApiAction_(action, payload) {
  switch (action) {
    // Customer / public
    case 'getPublicBootstrap': return apiGetPublicBootstrap_();
    case 'createOrder': return apiCreateOrder_(payload);
    case 'getMyOrders': return apiGetMyOrders_(payload);
    case 'getMyPoints': return apiGetMyPoints_(payload);
    case 'createCustomerLoyaltyQr': return apiCreateCustomerLoyaltyQr_(payload);
    case 'getLoyaltyQrStatus': return apiGetLoyaltyQrStatus_(payload);
    case 'getPointsHistory': return apiGetPointsHistory_(payload);
    case 'claimMerchantLoyaltyQr': return apiClaimMerchantLoyaltyQr_(payload);
    case 'getPublicCoupons': return apiGetPublicCoupons_();

    // Admin authentication
    case 'adminLogin': return apiAdminLogin_(payload);
    case 'adminLogout': return apiAdminLogout_(payload);
    case 'changeAdminPassword': return apiChangeAdminPassword_(payload);

    // Admin dashboard / orders
    case 'getAdminBootstrap': return apiGetAdminBootstrap_(payload);
    case 'getAdminOrders': return apiGetAdminOrders_(payload);
    case 'setOrderStatus': return apiSetOrderStatus_(payload);
    case 'getOrderDetail': return apiGetOrderDetail_(payload);

    // Admin menu management
    case 'saveCategory': return apiSaveCategory_(payload);
    case 'saveMenuItem': return apiSaveMenuItem_(payload);
    case 'deleteMenuItem': return apiDeleteMenuItem_(payload);
    case 'setMenuAvailability': return apiSetMenuAvailability_(payload);
    case 'saveOptionGroup': return apiSaveOptionGroup_(payload);
    case 'saveMenuOption': return apiSaveMenuOption_(payload);

    // Admin shop settings
    case 'setStoreStatus': return apiSetStoreStatus_(payload);
    case 'saveOrderLimitSettings': return apiSaveOrderLimitSettings_(payload);
    case 'saveStoreGeneralSettings': return apiSaveStoreGeneralSettings_(payload);
    case 'saveLoyaltySettings': return apiSaveLoyaltySettings_(payload);

    // Admin loyalty
    case 'createMerchantLoyaltyQr': return apiCreateMerchantLoyaltyQr_(payload);
    case 'getMerchantLoyaltyQrStatus': return apiGetMerchantLoyaltyQrStatus_(payload);
    case 'redeemCustomerLoyaltyQr': return apiRedeemCustomerLoyaltyQr_(payload);
    case 'adjustCustomerPoints': return apiAdjustCustomerPoints_(payload);
    case 'getAdminCustomers': return apiGetAdminCustomers_(payload);

    // Image upload (ImgBB key stays in Script Properties)
    case 'uploadImage': return apiUploadImage_(payload);

    default:
      return { ok: false, code: 'UNKNOWN_ACTION', message: 'ไม่พบ API action: ' + action };
  }
}

