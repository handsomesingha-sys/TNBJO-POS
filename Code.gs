function apiSaveCategory_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var categoryId = cleanText_(payload && payload.categoryId, 100) || newId_('CAT');
  var name = cleanText_(payload && payload.name, 100);
  if (!name) throw new Error('กรุณาระบุชื่อหมวดหมู่');
  var current = findById_('Categories', 'categoryId', categoryId);
  var now = new Date();
  var record = {
    categoryId: categoryId,
    name: name,
    sortOrder: toNumber_(payload.sortOrder, 0),
    isActive: payload.isActive === undefined ? true : asBoolean_(payload.isActive),
    createdAt: current ? current.createdAt : now,
    updatedAt: now
  };
  if (current) updateObjectById_('Categories', 'categoryId', categoryId, record);
  else appendObject_('Categories', record);
