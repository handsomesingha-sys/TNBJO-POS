function getStoreStatus_() {
  var settings = getSettingsObject_();
  var today = todayKey_();
  var changed = false;

  if (asBoolean_(settings.autoClosedByLimit) && String(settings.autoClosedDate || '') !== today) {
    settings.isOpen = true;
    settings.autoClosedByLimit = false;
    settings.autoClosedDate = '';
    settings.closeReason = '';
    settings.reopenAt = '';
    settings.autoReopen = false;
    changed = true;
  }

  if (!asBoolean_(settings.isOpen) && asBoolean_(settings.autoReopen) && settings.reopenAt) {
    var reopenMillis = dateMillis_(settings.reopenAt);
    if (reopenMillis && reopenMillis <= Date.now()) {
      settings.isOpen = true;
      settings.closeReason = '';
      settings.reopenAt = '';
      settings.autoReopen = false;
      settings.autoClosedByLimit = false;
      settings.autoClosedDate = '';
      changed = true;
    }
  }

  if (changed) {
    ['isOpen', 'autoClosedByLimit', 'autoClosedDate', 'closeReason', 'reopenAt', 'autoReopen'].forEach(function (key) {
      setSetting_(key, settings[key]);
    });
  }

  var todayOrders = countTodayOrders_();
  var limitEnabled = asBoolean_(settings.maxOrdersEnabled);
  var maxOrders = Math.max(0, toNumber_(settings.maxOrdersPerDay, 0));
  return {
    isOpen: asBoolean_(settings.isOpen),
    closeReason: String(settings.closeReason || ''),
    reopenAt: settings.reopenAt ? String(settings.reopenAt) : '',
    autoReopen: asBoolean_(settings.autoReopen),
    maxOrdersEnabled: limitEnabled,
    maxOrdersPerDay: maxOrders,
    ordersToday: todayOrders,
    remainingOrders: limitEnabled ? Math.max(0, maxOrders - todayOrders) : null,
    closedByLimit: asBoolean_(settings.autoClosedByLimit),
    restaurantName: String(settings.restaurantName || APP.DEFAULT_SETTINGS.restaurantName)
  };
}

function apiSetStoreStatus_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var isOpen = asBoolean_(payload && payload.isOpen);
  if (isOpen) {
    setSetting_('isOpen', true);
    setSetting_('closeReason', '');
    setSetting_('reopenAt', '');
    setSetting_('autoReopen', false);
    setSetting_('autoClosedByLimit', false);
    setSetting_('autoClosedDate', '');
    logAudit_('ADMIN', 'OPEN_STORE', 'STORE', 'isOpen', {});
    return { ok: true, store: getStoreStatus_(), message: 'เปิดรับออเดอร์แล้ว' };
  }

  var reason = cleanText_(payload && payload.reason, 300);
  if (!reason) throw new Error('กรุณาระบุเหตุผลที่ปิดรับออเดอร์');
  var reopenAtInput = cleanText_(payload && payload.reopenAt, 40);
  var parsedReopenAt = reopenAtInput ? parseLocalDateTime_(reopenAtInput) : null;
  if (reopenAtInput && !parsedReopenAt) throw new Error('เวลาเปิดร้านอีกครั้งไม่ถูกต้อง กรุณาใช้รูปแบบ YYYY-MM-DDTHH:mm');
  var reopenAt = parsedReopenAt ? parsedReopenAt.toISOString() : '';
  var autoReopen = Boolean(reopenAt);

  setSetting_('isOpen', false);
  setSetting_('closeReason', reason);
  setSetting_('reopenAt', reopenAt);
  setSetting_('autoReopen', autoReopen);
  setSetting_('autoClosedByLimit', false);
  setSetting_('autoClosedDate', '');
  logAudit_('ADMIN', 'CLOSE_STORE', 'STORE', 'isOpen', { reason: reason, reopenAt: reopenAt });
  return { ok: true, store: getStoreStatus_(), message: 'ปิดรับออเดอร์แล้ว' };
}

