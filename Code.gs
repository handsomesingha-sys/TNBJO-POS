function apiSaveStoreGeneralSettings_(payload) {
  requireAdmin_(payload && payload.sessionToken);
  var textFields = ['restaurantName', 'restaurantDescription', 'orderAcceptMessage', 'orderClosedMessage', 'homeBannerEyebrow', 'homeBannerTitle', 'homeBannerSubtitle'];
  textFields.forEach(function (key) {
    if (Object.prototype.hasOwnProperty.call(payload, key)) {
      var maxLength = key === 'restaurantDescription' || key === 'homeBannerSubtitle' || key.indexOf('Message') !== -1 ? 300 : 120;
      var value = cleanText_(payload[key], maxLength);
      if (key === 'restaurantName' && !value) throw new Error('กรุณาระบุชื่อร้าน');
      setSetting_(key, value);
    }
  });

  var imageFields = ['brandLogoUrl', 'homeBannerImageUrl'];
  imageFields.forEach(function (key) {
    if (Object.prototype.hasOwnProperty.call(payload, key)) {
      var imageUrl = safeHttpUrl_(payload[key]);
      setSetting_(key, imageUrl);
    }
  });

  if (Object.prototype.hasOwnProperty.call(payload, 'homeBannerHeight')) {
    var bannerHeight = Math.floor(toNumber_(payload.homeBannerHeight, 220));
